#!/bin/bash
#
# What the deployed service says it is, read off its health endpoint.
#
#   ts health              one field per line
#   ts health --raw        the response body verbatim
#   ts health --url URL    some other server
#
# Settings (bin/ts.env): URL; HEALTH_PATH, default /healthz.
# Hook: health-post, given the body, for what only the project can say about
# its own fields.
#
# Read-only, and the one command to run before believing anything a document
# says about production: what is running is a measurement, never a sentence.
#
# `commit` is what is actually running, stamped by `ts deploy` from the tree
# it sent, so `-dirty` means somebody deployed uncommitted work. It is
# compared here against this checkout's HEAD, because the difference is the
# whole reason to look: the same, ahead, or a sha this checkout has never
# seen.
set -euo pipefail
source "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../lib/common.sh"

raw=false
while [ $# -gt 0 ]; do
  case "$1" in
    --raw) raw=true ;;
    --url) shift; [ $# -gt 0 ] || die "--url needs a value"; URL=$1 ;;
    -h|--help) usage; exit 0 ;;
    *) die "unknown option: $1" ;;
  esac
  shift
done
need URL
HEALTH_PATH=${HEALTH_PATH:-/healthz}

# A failure here is the answer: an unreachable server and an unhealthy one
# are both "no", and curl already says which.
body=$(curl -fsS --max-time 10 "$URL$HEALTH_PATH") \
  || die "✗ $URL$HEALTH_PATH did not answer"

if $raw; then
  echo "$body"
  exit 0
fi

# Flat JSON is the whole assumption — no nesting, no arrays — which is what a
# health body should be, and why jq is not a dependency.
fields() {
  echo "$body" | tr -d '\n' | sed 's/^[[:space:]]*{//; s/}[[:space:]]*$//' \
    | sed 's/,[[:space:]]*"/\n"/g' \
    | sed -n 's/^[[:space:]]*"\([^"]*\)":[[:space:]]*"\{0,1\}\([^"]*\)"\{0,1\}[[:space:]]*$/\1\t\2/p'
}

echo "$URL"
while IFS=$'\t' read -r key value || [ -n "$key" ]; do
  note=""
  if [ "$key" = commit ]; then
    clean=${value%-dirty}
    if head=$(git -C "$TS_ROOT" rev-parse --short HEAD 2>/dev/null); then
      if [ "$clean" = "$head" ]; then
        note="  (this checkout's HEAD)"
      elif git -C "$TS_ROOT" merge-base --is-ancestor "$clean" HEAD 2>/dev/null; then
        note="  (HEAD is $(git -C "$TS_ROOT" rev-list --count "$clean"..HEAD) commit(s) ahead — undeployed)"
      elif git -C "$TS_ROOT" cat-file -e "$clean^{commit}" 2>/dev/null; then
        note="  (not an ancestor of HEAD — this checkout is behind or diverged)"
      else
        note="  (unknown here — fetch, or it was never pushed)"
      fi
    fi
  fi
  printf '  %-15s %s%s\n' "$key" "$value" "$note"
done < <(fields)

hook post "$body"
