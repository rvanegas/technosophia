#!/bin/bash
#
# The one implementation of title → slug → filename, for the three planning
# directories that are one file per item.
#
#   ts task "Some Title"            a new task — the common case, its own name
#   ts note new task "..."          the same thing, spelled out
#   ts note new backlog "..."       a new backlog item
#   ts note new decision "..."      a new decision, dated
#   ts note find "Some Title"       which file a quoted reference means
#   ts note list task               title and first sentence, one line each
#   ts note rename <file> "..."     retitle, and move the file to match
#   ts note check                   the invariants, for the test suite
#
# **The slug rule lives here and nowhere else.** Lowercase, every run of
# non-alphanumerics collapsed to a single hyphen, no leading or trailing one.
# PLANNING.md and each directory's README describe it in prose; this decides
# it. `check` stops the prose and the tree drifting apart: a project's test
# suite runs it, so drift fails the tests and therefore the deploy.
#
# Settings (bin/ts.env): NOTE_IGNORE, space-separated basenames in the three
# directories that are not entries.
#
# **`find` is the load-bearing mode**: PLANNING.md's matching rule made
# executable. Slugify the quotation, take an exact filename, else the unique
# file it prefixes, else refuse and say why. The refusal is the point: an
# ambiguous reference is reported, not guessed at.
#
# Verb-first throughout, including for the common case: a bare argument that
# means something different from a verb is a shape nobody remembers. The
# common case is short because it has its own name, `ts task`.

set -euo pipefail

source "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/../lib/common.sh"
root="$TS_ROOT"
planning="$root/planning"

die() { echo "note: $*" >&2; exit 1; }

# The rule. Everything else in this file is bookkeeping around it.
slug() {
  printf '%s' "$1" \
    | tr '[:upper:]' '[:lower:]' \
    | sed -E 's/[^a-z0-9]+/-/g; s/^-+//; s/-+$//'
}

# The `#` heading of a file, without the marker. Empty if it has none.
heading() {
  local first
  first="$(head -1 "$1")"
  [[ "$first" == '# '* ]] && printf '%s' "${first:2}"
}

# A decision's filename carries the date its title does not; strip it before
# comparing. Only decision/ is dated (PLANNING.md).
expected_slug() {
  local dir="$1" title="$2"
  if [[ "$dir" == decision ]]; then
    printf '%s-%s' "$(date +%F)" "$(slug "$title")"
  else
    slug "$title"
  fi
}

# The slug a decision file's name should have, given its heading, keeping
# whatever date the file already carries rather than today's.
stored_slug() {
  local dir="$1" base="$2" title="$3"
  if [[ "$dir" == decision && "$base" =~ ^([0-9]{4}-[0-9]{2}-[0-9]{2})- ]]; then
    printf '%s-%s' "${BASH_REMATCH[1]}" "$(slug "$title")"
  else
    slug "$title"
  fi
}

dirs_with_entries() { echo "task backlog decision"; }

valid_dir() {
  case "$1" in
    task|backlog|decision) return 0 ;;
    *) die "no such directory '$1' — one of task, backlog, decision" ;;
  esac
}

# Files that are entries. READMEs are the convention, not an item, and
# NOTE_IGNORE names any other file that is not one.
entries() {
  local dir="$1" f base
  for f in "$planning/$dir"/*.md; do
    [[ -e "$f" ]] || continue
    base="$(basename "$f" .md)"
    [[ "$base" == README ]] && continue
    [[ " ${NOTE_IGNORE:-} " == *" $base "* ]] && continue
    echo "$f"
  done
}

cmd_new() {
  local dir="${1:-}" title="${2:-}"
  [[ -n "$dir" && -n "$title" ]] || die "usage: ts note new <task|backlog|decision> \"Some Title\""
  valid_dir "$dir"
  local s path
  s="$(expected_slug "$dir" "$title")"
  [[ -n "$s" ]] || die "that title slugifies to nothing"
  path="$planning/$dir/$s.md"
  [[ -e "$path" ]] && die "already exists: ${path#$root/}"

  # A heading and nothing else. The file is the request; somebody writes it.
  printf '# %s\n' "$title" > "$path"
  echo "${path#$root/}"
}

cmd_find() {
  local query="${1:-}"
  [[ -n "$query" ]] || die "usage: ts note find \"Some Title\""
  local s hits=() f base
  s="$(slug "$query")"
  [[ -n "$s" ]] || die "that reference slugifies to nothing"

  # Exact first, then unique prefix — PLANNING.md's rule, in that order. A
  # decision's date prefix means the match is tried against the undated tail
  # as well, so a citation that names only the title still resolves.
  for dir in $(dirs_with_entries); do
    while read -r f; do
      [[ -n "$f" ]] || continue
      base="$(basename "$f" .md)"
      [[ "$base" == "$s" ]] && { echo "${f#$root/}"; return 0; }
      [[ "$base" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}-(.*)$ && "${BASH_REMATCH[1]}" == "$s" ]] \
        && { echo "${f#$root/}"; return 0; }
    done < <(entries "$dir")
  done

  for dir in $(dirs_with_entries); do
    while read -r f; do
      [[ -n "$f" ]] || continue
      base="$(basename "$f" .md)"
      base="${base#[0-9][0-9][0-9][0-9]-[0-9][0-9]-[0-9][0-9]-}"
      [[ "$base" == "$s"* ]] && hits+=("$f")
    done < <(entries "$dir")
  done

  case "${#hits[@]}" in
    0) echo "note: nothing matches '$query' (slug: $s)" >&2; return 1 ;;
    1) echo "${hits[0]#$root/}" ;;
    *)
      # Listing forty of them helps nobody; a handful shows the shape of the
      # collision, which is what somebody needs to lengthen the quotation.
      {
        echo "note: '$query' is ambiguous — it prefixes ${#hits[@]} files:"
        printf '  %s\n' "${hits[@]:0:8}" | sed "s|$root/||"
        [[ "${#hits[@]}" -gt 8 ]] && echo "  … and $(( ${#hits[@]} - 8 )) more"
        echo "Not a reference. Say more of the title."
      } >&2
      return 1 ;;
  esac
}

cmd_list() {
  local dir="${1:-task}" f title body
  valid_dir "$dir"
  while read -r f; do
    [[ -n "$f" ]] || continue
    title="$(heading "$f")"
    # The first sentence of the body, which is as much index as anybody needs.
    body="$(tail -n +2 "$f" | grep -v '^[[:space:]]*$' | head -1 \
      | sed -E 's/\*\*//g; s/^[-*] //' | cut -c1-90)"
    if [[ -n "$body" ]]; then
      printf '%s\n    %s\n' "$title" "$body"
    else
      printf '%s\n    (a heading and nothing else)\n' "$title"
    fi
  done < <(entries "$dir")
}

cmd_rename() {
  local file="${1:-}" title="${2:-}"
  [[ -n "$file" && -n "$title" ]] || die "usage: ts note rename <file> \"New Title\""
  [[ -f "$file" ]] || die "no such file: $file"
  local dir base s dest
  dir="$(basename "$(dirname "$(cd "$(dirname "$file")" && pwd)/$(basename "$file")")")"
  valid_dir "$dir"
  base="$(basename "$file" .md)"
  s="$(stored_slug "$dir" "$base" "$title")"
  [[ -n "$s" ]] || die "that title slugifies to nothing"
  dest="$planning/$dir/$s.md"

  # The heading is the title; the filename follows from it. Both, or neither.
  local tmp
  tmp="$(mktemp)"
  { printf '# %s\n' "$title"; tail -n +2 "$file"; } > "$tmp"
  mv "$tmp" "$file"
  if [[ "$dest" != "$(cd "$(dirname "$file")" && pwd)/$(basename "$file")" ]]; then
    [[ -e "$dest" ]] && die "would collide with ${dest#$root/}"
    # `git mv` keeps the rename legible in the diff, but refuses a file git has
    # never seen — which is the ordinary case for a task retitled minutes after
    # `ts task` made it.
    if git -C "$root" ls-files --error-unmatch "$file" >/dev/null 2>&1; then
      git -C "$root" mv "$file" "$dest"
    else
      mv "$file" "$dest"
    fi
  fi
  echo "${dest#$root/}"
}

# What is checked differs by directory, and the difference is the rule.
#
# **task/ and backlog/ are held to the strict rule**: the heading slugifies
# to the filename, exactly.
#
# **decision/ is held to having a date in its name and a heading, and nothing
# more.** A decision's filename is what references resolve against and is
# fixed when the file is made; its heading is the title in whatever form
# suits. Retitling an old decision to fit would break every reference to it.
cmd_check() {
  local bad=0 seen=() f base title want dir
  for dir in $(dirs_with_entries); do
    [[ -d "$planning/$dir" ]] || { echo "missing directory: planning/$dir" >&2; bad=1; continue; }
    [[ -f "$planning/$dir/README.md" ]] || { echo "planning/$dir has no README.md" >&2; bad=1; }
    while read -r f; do
      [[ -n "$f" ]] || continue
      base="$(basename "$f" .md)"
      title="$(heading "$f")"
      if [[ -z "$title" ]]; then
        echo "no '# ' heading: planning/$dir/$base.md" >&2; bad=1; continue
      fi
      if [[ "$dir" == decision ]]; then
        [[ "$base" =~ ^[0-9]{4}-[0-9]{2}-[0-9]{2}- ]] \
          || { echo "a decision's filename starts with its date: planning/$dir/$base.md" >&2; bad=1; }
        continue
      fi
      want="$(slug "$title")"
      if [[ "$base" != "$want" ]]; then
        echo "heading and filename disagree: planning/$dir/$base.md holds \"$title\" (wants $want.md)" >&2
        bad=1
      fi
      for s in ${seen[@]+"${seen[@]}"}; do
        [[ "$s" == "$base" ]] && { echo "slug used twice across task/ and backlog/: $base.md" >&2; bad=1; }
      done
      seen+=("$base")
    done < <(entries "$dir")
  done

  [[ "$bad" == 0 ]] || return 1
  echo "planning/: every task and backlog filename is its heading's slug; decisions are dated and titled"
}

verb="${1:-}"
shift || true
case "$verb" in
  new)    cmd_new "$@" ;;
  find)   cmd_find "$@" ;;
  list)   cmd_list "$@" ;;
  rename) cmd_rename "$@" ;;
  check)  cmd_check "$@" ;;
  ''|-h|--help)
    usage
    ;;
  *) die "no such verb '$verb' — one of new, find, list, rename, check" ;;
esac
